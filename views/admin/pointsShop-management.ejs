<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fitboy</title>
    <link rel="icon" type="image/png" href="https://sdmntprwestus.oaiusercontent.com/files/00000000-c55c-5230-a6d3-57d94542e9ce/raw?se=2025-09-26T13%3A21%3A02Z&sp=r&sv=2024-08-04&sr=b&scid=50bc2cad-81b4-51b0-9319-9c4a05e0d387&skoid=e9d2f8b1-028a-4cff-8eb1-d0e66fbefcca&sktid=a48cca56-e6da-484e-a814-9c849652bcb3&skt=2025-09-26T00%3A00%3A31Z&ske=2025-09-27T00%3A00%3A31Z&sks=b&skv=2024-08-04&sig=dI9OiC4Yadh6f%2B6Ni5bLRwAxrVWqRiKA2VC9SVPY95g%3D"> 
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/style.css">
    <style>
        /* All styles remain the same as provided */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: white;
            min-height: 100vh;
        }

        .admin-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .dashboard-content {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title {
            color: rgb(31, 31, 31);
            font-size: 28px;
            font-weight: 600;
            margin: 0;
        }
/* Container for the games grid */
.games-grid1 {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

/* Individual game card */
.game-card1 {
  height: 500px;
  background: #1e1e2f;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  color: #fff;
  display: flex;
  flex-direction: column;
  position: relative;
}

.game-card1:hover {
  transform: translateY(-5px);
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
}

/* Game image */
.game-image1 {
  width: 100%;
  height: 80%;
  overflow: hidden;
}

.game-image1 img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Title */
.game-title1 {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18px;
  font-weight: 600;
  color: #ffcc00;
  text-align: center;
  width: 90%;
  text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);
}

/* Description */
.game-description1 {
  font-size: 14px;
  margin: 8px 12px 12px;
  color: #bbb;
  text-align: center;
  min-height: 40px;
}

/* Meta info (category, price, etc.) */
.game-meta1 {
  font-size: 14px;
  margin: 0 12px 12px;
  line-height: 1.5;
}

.game-meta1 p {
  margin: 4px 0;
}

/* Buttons */
.action-btn1 {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 14px;
  margin: 10px;
  font-size: 14px;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s ease;
  border: none;
}

.delete-btn1 {
  background: #ff4c4c;
  color: #fff;
}

.delete-btn1:hover {
  background: #d93636;
}

/* Pagination */
.pagination1 {
  display: flex;
  justify-content: center;
  margin: 30px 0;
  gap: 10px;
}

.pagination1 a {
  background: #2c2c3a;
  color: #fff;
  padding: 8px 14px;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.2s ease;
}

.pagination1 a:hover {
  background: #44445c;
}

.pagination1 .active1 {
  background: #ffcc00;
  color: #000;
  font-weight: bold;
}

        
        .add-button {
            background: linear-gradient(45deg, #ff6b6b, #ee5a24);
            color: rgb(59, 27, 27);
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .add-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 107, 107, 0.3);
        }

        .empty-state {
            color: #000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 400px;
            text-align: center;
        }

        .empty-state-icon {
            color: #000000;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .empty-state-icon:hover {
            background: rgba(31, 29, 29, 0.2);
            transform: scale(1.05);
        }

        .empty-state-icon i {
            font-size: 48px;
            color: rgb(37, 33, 33);
        }

        .empty-state h3 {
            color: white;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: rgba(10, 6, 6, 0.7);
            font-size: 16px;
        }

        .games-container {
            display: none;
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .game-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .game-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(88, 88, 88, 0.2);
        }

        .game-image {
            width: 100%;
            height: 150px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.5);
            font-size: 48px;
        }

        .game-title {
            color: white;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .game-description {
            color: rgba(255, 255, 255, 0.7);
            font-size: 14px;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .game-points {
            color: #ffd700;
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 15px;
        }

        .game-actions {
            display: flex;
            gap: 10px;
        }

        .action-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .delete-btn {
            background: linear-gradient(45deg, #e74c3c, #c0392b);
            color: white;
        }

        .action-btn:hover {
            transform: translateY(-2px);
        }

        .game-selection-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(0.1px);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .game-selection-container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            width: 90%;
            max-width: 800px;
            max-height: 80vh;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .selection-header {
            padding: 20px 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .selection-header h3 {
            color: white;
            font-size: 20px;
            font-weight: 600;
            margin: 0;
        }

        .close-selection {
            background: none;
            border: none;
            color: white;
            font-size: 24px;
            cursor: pointer;
            padding: 5px;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .close-selection:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .selection-content {
            padding: 20px 25px;
            max-height: 60vh;
            overflow-y: auto;
        }

        .available-games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .selectable-game {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .selectable-game:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        .selectable-game.selected {
            border-color: #27ae60;
            background: rgba(39, 174, 96, 0.2);
        }

        .selectable-game.selected::after {
            content: '✓';
            position: absolute;
            top: 10px;
            right: 10px;
            background: #27ae60;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
        }

        .selectable-game-image {
            width: 100%;
            height: 100px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.5);
            font-size: 24px;
        }

        .selectable-game-title {
            color: white;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .selectable-game-points {
            color: #ffd700;
            font-size: 12px;
            font-weight: 600;
        }

        .selection-footer {
            padding: 20px 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .selected-count {
            color: rgba(255, 255, 255, 0.7);
            font-size: 14px;
        }

        .selection-actions {
            display: flex;
            gap: 15px;
        }

        .btn-add-selected {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-add-selected:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-add-selected:not(:disabled):hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(39, 174, 96, 0.3);
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        @media (max-width: 768px) {
            .games-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
            <%- include('partials/header') %>
        <%- include('partials/sidebar', {page: '/points-management'}) %>

        <div class="main-content">
            <div class="dashboard-content">
                <div class="page-header" id="pageHeader" style="<%= products && products.length > 0 ? '' : 'display: none;' %>">
                    <h2 class="page-title">Points Store Games</h2>
                    <button class="add-button" onclick="showAddForm()">
                        <i class="fas fa-plus"></i>
                        Add New Game
                    </button>
                </div>

                <form method="GET" action="/admin/points-management" class="search-bar" style="margin-bottom: 20px; display: flex; gap: 10px; align-items: center;">
    <input 
        type="text" 
        name="search" 
        placeholder="Search games..." 
        value="<%= search %>" 
        class="form-control"
        style="flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc;"
    >
    
    <button type="submit" class="btn btn-primary" style="padding: 8px 16px; border-radius: 8px;">
        <i class="fas fa-search"></i> Search
    </button>
</form>

                <div class="game-selection-modal" id="gameSelectionModal">
                    <div class="game-selection-container">
                        <div class="selection-header">
                            <h3>Select Games to Add</h3>
                            <button class="close-selection" onclick="hideGameSelection()">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="selection-content">
                            <div class="available-games-grid" id="availableGamesGrid">
                                <!-- Available games will be loaded here -->
                            </div>
                        </div>
                        <div class="selection-footer">
                            <div class="selected-count" id="selectedCount">0 games selected</div>
                            <div class="selection-actions">
                                <button class="btn-cancel" onclick="hideGameSelection()">Cancel</button>
                                <button class="btn-add-selected" id="addSelectedBtn" onclick="addSelectedGames()" disabled>
                                    Add Selected
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="empty-state" id="emptyState" style="<%= products && products.length > 0 ? 'display: none;' : '' %>">
                    <div class="empty-state-icon" onclick="showAddForm()">
                        <i class="fas fa-plus"></i>
                    </div>
                    <h3>No Games Added Yet</h3>
                    <p>Click the plus button to add your first game to the points store</p>
                </div>

               <div class="games-grid1">
  <% products.forEach(function(game) { %>
    <div class="game-card1">
      <div class="game-image1">
        <% if (game.poster) { %>
          <img src="<%= game.poster %>" alt="<%= game.name %>">
        <% } else { %>
          <i class="fas fa-gamepad" style="font-size:40px;color:#888;"></i>
        <% } %>
      </div>
      <div class="game-title1"><%= game.name %></div>
      <div class="game-meta1">
        <p><b>Price:</b> ₹<%= game.regularPrice %></p>
        <p><b>Points Required:</b> <%= game.pointsRequired %> pts</p>
      </div>
<button class="action-btn1 delete-btn1" onclick="deleteFromPointsShop('<%= game._id %>')">
  <i class="fas fa-trash"></i> Remove
</button>

    </div>
  <% }); %>
</div>


            </div>
        </div>
    </div>
            <div style="margin-bottom: 70px;">
        </div>
            </div>
            
            <%- include('partials/footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let availableGames = [];
        let selectedGames = [];

        // No need for fetchGames, use server-rendered data
        // Games are already rendered server-side
        // For dynamic updates after add/delete, reload page

        async function showAddForm() {
            try {
                const response = await fetch('/admin/products');
                availableGames = await response.json();
                showGameSelection();
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to fetch available games. Please try again.',
                });
            }
        }

        function showGameSelection() {
            selectedGames = [];
            document.getElementById('gameSelectionModal').style.display = 'flex';
            renderAvailableGames();
            updateSelectedCount();
        }

        function hideGameSelection() {
            document.getElementById('gameSelectionModal').style.display = 'none';
            selectedGames = [];
        }

        function renderAvailableGames() {
            const availableGamesGrid = document.getElementById('availableGamesGrid');
            availableGamesGrid.innerHTML = availableGames.map(game => `
                <div class="selectable-game" onclick="toggleGameSelection('${game._id}')" data-game-id="${game._id}">
                    <div class="selectable-game-image">
                        ${game.poster ? `<img src="${game.poster}" alt="${game.name}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;">` : '<i class="fas fa-gamepad"></i>'}
                    </div>
                    <div class="selectable-game-title">${game.name}</div>
                    <div class="selectable-game-points">${game.regularPrice} price</div>
                </div>
            `).join('');
        }

        function toggleGameSelection(gameId) {
            const gameElement = document.querySelector(`[data-game-id="${gameId}"]`);
            const gameIndex = selectedGames.indexOf(gameId);

            if (gameIndex > -1) {
                selectedGames.splice(gameIndex, 1);
                gameElement.classList.remove('selected');
            } else {
                selectedGames.push(gameId);
                gameElement.classList.add('selected');
            }

            updateSelectedCount();
        }

        function updateSelectedCount() {
            const countElement = document.getElementById('selectedCount');
            const addButton = document.getElementById('addSelectedBtn');
            countElement.textContent = `${selectedGames.length} games selected`;
            addButton.disabled = selectedGames.length === 0;
        }

        async function addSelectedGames() {
            if (selectedGames.length === 0) return;

            try {
                const response = await fetch('/admin/points-management/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gameIds: selectedGames })
                });

                if (response.ok) {
                    location.reload(); // Reload to update the list
                    hideGameSelection();
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: `games added successfully!`,
                    });
                } else {
                    throw new Error('Failed to add games');
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to add games. Please try again.',
                });
            }
        }

        async function deleteGame(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74c3c',
                cancelButtonColor: '#95a5a6',
                confirmButtonText: 'Yes, delete it!'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/points-management/${id}`, {
                            method: 'DELETE'
                        });

                        if (response.ok) {
                            location.reload(); // Reload to update the list
                            Swal.fire(
                                'Deleted!',
                                'Game has been removed.',
                                'success'
                            );
                        } else {
                            throw new Error('Failed to delete game');
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to delete game. Please try again.',
                        });
                    }
                }
            });
        }

async function deleteFromPointsShop(id) {
  const result = await Swal.fire({
    title: 'Are you sure?',
    text: "This game will be removed from the Points Shop!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#3085d6',
    cancelButtonColor: '#d33',
    confirmButtonText: 'Yes, remove it!',
    cancelButtonText: 'Cancel'
  });

  if (result.isConfirmed) {
    try {
      const response = await fetch(`/admin/points-management/${id}`, {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json"
        }
      });

      if (response.ok) {
        Swal.fire(
          'Removed!',
          'Game has been removed from the Points Shop.',
          'success'
        ).then(() => {
          location.reload(); // refresh page after delete
        });
      } else {
        const data = await response.json();
        Swal.fire('Error', data.message || 'Failed to remove game', 'error');
      }
    } catch (err) {
      console.error(err);
      Swal.fire('Error', 'Server error', 'error');
    }
  }
}
    </script>
</body>
</html>